/* ar.wxss：AR 页样式 */

.page {
  position: relative;
  width: 100%;
  height: 100vh;
  background-color: #000000;
  overflow: hidden;
}

/* 相机铺满整屏 */
.camera {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* ---------- 相机失败时的降级背景 ---------- */
.fallback {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #1c1c1a;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
}

.fallback-title {
  font-size: 34rpx;
  color: #ffffff;
  font-weight: 500;
}

.fallback-desc {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.8;
  text-align: center;
  white-space: pre-wrap;
}

/* ---------- 叠加层 ---------- */
.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
}

/* 顶部目标 */
.hud-top {
  position: absolute;
  top: 72rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hud-target {
  font-size: 34rpx;
  font-weight: 500;
  color: #ffffff;
  /* 画面颜色不确定，加一层阴影保证文字始终看得清 */
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.7);
}

.hud-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.7);
}

/* ---------- 箭头 ---------- */
.arrow-area {
  position: absolute;
  top: 24%;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 整个箭头跟着 heading 旋转，transition 让转动更顺滑 */
.arrow {
  width: 120rpx;
  height: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.2s linear;
}

/* 三角形箭头尖：CSS 边框画三角的标准写法 */
.arrow-head {
  width: 0;
  height: 0;
  border-left: 60rpx solid transparent;
  border-right: 60rpx solid transparent;
  border-bottom: 84rpx solid rgba(255, 255, 255, 0.95);
}

/* 箭杆 */
.arrow-stem {
  width: 24rpx;
  height: 120rpx;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 4rpx;
}

.distance {
  margin-top: 20rpx;
  font-size: 48rpx;
  font-weight: 500;
  color: #ffffff;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.8);
}

/* ---------- 下一步提示 ---------- */
.hint-card {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 216rpx;
  padding: 24rpx 28rpx;
  background-color: rgba(0, 0, 0, 0.55);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
}

.hint-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.hint-text {
  margin-top: 10rpx;
  font-size: 30rpx;
  color: #ffffff;
  line-height: 1.6;
}

/* ---------- 按钮 ---------- */
.btn-row {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 80rpx;
  display: flex;
}

.hud-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  color: #ffffff;
  background-color: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 20rpx;
}

.hud-btn-primary {
  margin-left: 20rpx;
  background-color: #185fa5;
  border-color: #185fa5;
}

.pressed {
  opacity: 0.6;
}
