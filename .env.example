# Copy to .env at the repository root and fill in your LLM configuration.
# Existing environment variables take precedence. This example is not loaded automatically.
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-id
# Optional protocol options as a JSON object.
LLM_REQUEST_OPTIONS='{}'

# Relative to the .env directory; without .env, relative to the working directory.
NAVIGATION_BUILDINGS_FILE=backend/buildings.example.json
HTTP_BIND=127.0.0.1:3000
# 应用日志默认为info；排查时可改为warn,ar_navigation=debug。
RUST_LOG=warn,ar_navigation=info
SESSION_TTL_SECONDS=1800
TURN_TIMEOUT_SECONDS=60
MAX_SESSIONS=1000
MAX_CONCURRENT_TURNS=16
MAX_LLM_CALLS=8
MAX_TOOL_CALLS=12
MAX_HISTORY_BYTES=262144
